# Copy to .env for local development. Never commit .env.

# --- Database -------------------------------------------------------------------
# Local Postgres + PostGIS, e.g.:
#   docker run --name parkfree-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgis/postgis:16-3.4
#   then: psql "$DATABASE_URL" -c 'create extension if not exists postgis;'
# Managed (production): a Supabase or Neon connection string (includes ?sslmode=require).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parkfree

# "disable" for a local non-SSL Postgres. Leave unset for Supabase / Neon.
PGSSL=disable

# --- Server ---------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# NODE_ENV=production   # set by fly.toml in production

# --- External APIs --------------------------------------------------------------
# TfL Unified API key — needed from Step 10 (journey planning). Get one at
# https://api-portal.tfl.gov.uk/. Free tier: 500 requests/hour.
TFL_APP_KEY=

# Optional Socrata app token — raises the anonymous rate limit on Camden's
# open-data API (https://opendata.camden.gov.uk/profile/app_tokens). The Camden
# CPZ adapter (step 3) works without it.
SOCRATA_APP_TOKEN=
