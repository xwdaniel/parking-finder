# Copy to app/.env (gitignored) and fill in. Loaded by Expo before app.config.ts and
# inlined into the JS bundle for EXPO_PUBLIC_* names. See decisions.md D26 / D27.

# --- Mapbox (Step 8: Map + Results) ---------------------------------------------
# Both come from your Mapbox account → Tokens (https://account.mapbox.com/access-tokens/).
# Without them the app still builds; MapResultsScreen shows a no-map fallback.
#
# Public token (pk.*) — used at runtime by Mapbox.setAccessToken(). The default public
# token is fine. (Inlined into the JS bundle — it's a public token, not a secret.)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Secret token (sk.*) — create one with ONLY the "Downloads:Read" scope. Used at prebuild
# by the @rnmapbox/maps config plugin to download the native SDK. Build-time only; never
# shipped in the bundle. Keep it secret — this is why app/.env is gitignored.
MAPBOX_DOWNLOAD_TOKEN=

# --- Google Places (Step 7: destination autocomplete) — optional --------------------
# If set, the destination field uses Google Places autocomplete; otherwise it falls back
# to Apple's on-device geocoder. (Currently wired via app.json `extra.googlePlacesApiKey`;
# move it here as EXPO_PUBLIC_GOOGLE_PLACES_API_KEY if you prefer keeping keys out of git.)
